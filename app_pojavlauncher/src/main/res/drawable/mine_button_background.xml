<?xml version="1.0" encoding="utf-8" ?>
<!-- Neon blue button (PLAY, confirm, etc.) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#80101830" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#40507AC0" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E01049B5" />
            <corners android:radius="6dp" />
            <stroke android:width="2dp" android:color="#7FB4FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D00A1638" />
            <corners android:radius="6dp" />
            <stroke android:width="2dp" android:color="#2D8CFF" />
        </shape>
    </item>
</selector>
